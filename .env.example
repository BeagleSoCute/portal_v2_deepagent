# Copy to .env. Read by `docker compose` and passed into the container.

# Shown once when an admin creates the app `agents` in the Portal (or after Rotate secret).
AGENTS_CLIENT_SECRET=

# Encrypts the tokens of signed-in users at rest. Create one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENTS_TOKEN_ENCRYPTION_KEY=

# Python tools let a signed-in user run their own code inside the container.
# Leave empty unless everyone with access to this app may do that.
ALLOW_PYTHON_TOOLS=
