# ตั้งแต่ย้ายมาใช้ Connection ที่ตั้งจาก UI แล้ว
# ไฟล์นี้ไม่จำเป็นสำหรับการใช้งานปกติอีกต่อไป — LLM base_url/api key ตั้งในหน้าเว็บ
# ที่เหลืออยู่ในนี้คือ "นโยบายของ deployment" (Tier B) ไม่ใช่ config ของผู้ใช้

# กุญแจหลักสำหรับเข้ารหัส api key ที่ผู้ใช้กรอก
# ไม่ตั้งก็ได้ ระบบจะสร้างเก็บไว้ที่ data/.secret_key (0600) ให้เอง
# ตั้งเองเมื่อ: รันหลาย instance, หรือย้ายเครื่องแล้วอยากให้ถอดรหัสของเดิมได้
# สร้างด้วย: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_KEY=

# จำกัด host ของ base_url ที่ยอมให้ผู้ใช้ชี้ไป (คั่นด้วย comma) — ว่าง = ไม่จำกัด
LLM_BASE_URL_ALLOWED_HOSTS=

# egress allowlist ของ http tool (คั่นด้วย comma) — ว่าง = บล็อกหมด
HTTP_TOOL_ALLOWED_HOSTS=

# --- tool ชนิด python (ผู้ใช้วางโค้ดเองจาก UI) ---
# ปิดเป็นค่าเริ่มต้น เพราะคนที่วางโค้ดได้ = คนที่รันโค้ดบนเครื่องนี้ได้
# เปิดได้เมื่อ "ทุกคนที่เข้าถึง UI ได้ เชื่อถือได้เท่ากับคนที่มีสิทธิ์ deploy" เท่านั้น
ALLOW_PYTHON_TOOLS=

# module ที่โค้ดของผู้ใช้ import ได้ — เว้นว่าง = ใช้ค่า default ใน python_tools.py
PYTHON_TOOL_ALLOWED_IMPORTS=

# env ที่ยอมส่งต่อให้ subprocess ของ tool (เช่น proxy) — เว้นว่าง = ไม่ส่งอะไรเลย
# อย่าใส่ชื่อตัวแปรที่เป็น secret ลงตรงนี้
PYTHON_TOOL_PASS_ENV=

# secret สำหรับ http tool: spec อ้างด้วยชื่อ เช่น {"secret_ref": "CRM_TOKEN"}
# CRM_TOKEN=

DATA_DIR=./data

# --- ทางเลือกรอง: โหมด env ---
# spec ที่ไม่ระบุ connection จะ fallback มาอ่านตัวแปรพวกนี้ (สะดวกตอนรัน CLI/CI)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
